<resources>
    <!-- System bars are transparent: MainActivity draws edge-to-edge and colours its own bars. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The share screen: fully transparent, only its dialog shows over the app the link was shared from. -->
    <style name="ShareTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The filter chips above the Library list: outlined, slightly rounded rectangles. -->
    <style name="LibraryFilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipCornerRadius">12dp</item>
    </style>

    <!-- Rounded corners of a Library thumbnail. -->
    <style name="ThumbRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="DownloadSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <!-- The browser screen: dark green from the first frame (no white flash while it opens). -->
    <style name="BrowserTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/browserBg</item>
    </style>

    <!-- A section title on the browser's main screen ("Quick sites", "Recently opened"). -->
    <style name="BrowserSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/browserHint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- The round-cornered square buttons (paste / download) of the browser screen. -->
    <style name="BrowserFabShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- The bottom sheets of the browser screen: dark green with rounded top corners, whatever the day / night mode. -->
    <style name="BrowserSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BrowserSheet</item>
    </style>

    <style name="BrowserSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/browserSheet</item>
        <item name="shapeAppearanceOverlay">@style/BrowserSheetShape</item>
    </style>

    <style name="BrowserSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
