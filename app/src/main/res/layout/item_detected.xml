<?xml version="1.0" encoding="utf-8"?>
<!-- One video / audio / file found on the page: a tinted icon tile (its color says what it is), the name, a small badge
     (the format) with the kind and the site, and a download button at the end. DetectedSheet fills it in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detectedRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_sheet_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_sheet_ripple"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/detectedTile"
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/detectedIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detectedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/browserText"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detectedMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/browserHint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/detectedAction"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_sheet_action"
        android:contentDescription="@string/download"
        android:padding="8dp"
        android:src="@drawable/ic_download_24dp"
        app:tint="@color/browserFabIcon" />
</LinearLayout>
