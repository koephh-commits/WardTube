<?xml version="1.0" encoding="utf-8"?>
<!-- One downloaded file: picture (video frame / audio cover) on the start side, name and details, and a menu button
     (share / delete) on the end. Tap the row to play. While several files are being selected the menu button gives
     way to a check box, a tap ticks the row, and a ticked row is tinted (bg_library_row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_library_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <!-- 16:9 box. The icon shows until the picture is ready, and stays for files that have none. -->
    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="63dp"
        android:background="@drawable/bg_thumb_soft">

        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_play_white_24dp"
            app:tint="@color/brandText" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ThumbRounded" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            tools:text="Song name.mp3" />

        <TextView
            android:id="@+id/tvFileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            tools:text="MP3 • 4.2 MB • Oct 3, 2026" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/moreOptions"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert_24dp"
        app:tint="?android:attr/textColorSecondary" />

    <!-- Not clickable on purpose: the tap reaches the row, which ticks it. -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
