<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browserBg"
    tools:context=".browser.BrowserActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top row: back, Library and History (the first buttons of the Seal app), then the big thin title.
             While a page is open the title is hidden (it keeps its room) and the page buttons show at the far end:
             previous page, next page, Reload and Home. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/browserBack"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserBack"
                android:src="@drawable/ic_arrow_back_white_24dp"
                android:tint="@color/browserText" />

            <ImageButton
                android:id="@+id/browserLibrary"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/library"
                android:src="@drawable/ic_library_white_24dp"
                android:tint="@color/browserText" />

            <ImageButton
                android:id="@+id/browserHistory"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserHistory"
                android:src="@drawable/ic_history_white_24dp"
                android:tint="@color/browserText" />

            <TextView
                android:id="@+id/browserTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/browser"
                android:textAlignment="viewStart"
                android:textColor="@color/browserText"
                android:textSize="34sp" />

            <ImageButton
                android:id="@+id/browserPrev"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserPrevious"
                android:src="@drawable/ic_chevron_back_24dp"
                android:tint="@color/browserText"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/browserNext"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserNext"
                android:src="@drawable/ic_chevron_24dp"
                android:tint="@color/browserText"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/browserReload"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserReload"
                android:src="@drawable/ic_refresh_24dp"
                android:tint="@color/browserText"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/browserHome"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserHome"
                android:src="@drawable/ic_home_white_24dp"
                android:tint="@color/browserText"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The link field: one filled pill. At its start the globe (starts the search), then the text, the x that
             clears it (only while there is text) and, at its end, the button that shows the search engine in use and
             opens the picker. The pill is outlined in light green while the text has the focus. -->
        <LinearLayout
            android:id="@+id/browserFieldPill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_browser_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/browserGo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserOpen"
                android:padding="8dp"
                android:src="@drawable/ic_globe_white_24dp"
                android:tint="@color/browserFabIcon" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/browserField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical|start"
                android:hint="@string/browserLinkHint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/browserText"
                android:textColorHint="@color/browserHint"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/browserClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browserClear"
                android:padding="8dp"
                android:src="@drawable/ic_close_24dp"
                android:tint="@color/browserHint"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/browserEngineButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_engine_chip"
                android:clickable="true"
                android:contentDescription="@string/browserEngineTitle"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/browserEngineBadge"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_expand_more_white_24dp"
                    app:tint="@color/browserHint" />
            </LinearLayout>
        </LinearLayout>

        <!-- The main screen under the field: quick sites, the last pages opened, and a hint about the floating button.
             Hidden while a page is open (see BrowserActivity / BrowserHome). The bottom room is for the Paste button. -->
        <ScrollView
            android:id="@+id/browserHomeScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="96dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/BrowserSectionLabel"
                    android:text="@string/browserQuickSites" />

                <!-- Rows of four tiles, built by BrowserHome. -->
                <LinearLayout
                    android:id="@+id/browserQuickSites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/browserRecentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/BrowserSectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/browserRecent" />

                    <TextView
                        android:id="@+id/browserRecentAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_chevron_24dp"
                        android:drawableTint="@color/browserFabIcon"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="@string/browserRecentAll"
                        android:textColor="@color/browserFabIcon"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- The last pages opened (rows built by BrowserHome), in one rounded card. -->
                <LinearLayout
                    android:id="@+id/browserRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_browser_card"
                    android:clipToOutline="true"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- How to download: shows the floating button as it looks on a page. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_browser_tip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_browser_tip_button">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_download_24dp"
                            app:tint="@color/browserFab" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/browserTip"
                        android:textAlignment="viewStart"
                        android:textColor="@color/browserHint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- The page being browsed. Its WebView is created only when a page is opened (see BrowserActivity). -->
        <FrameLayout
            android:id="@+id/browserWebContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/browserProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progressBackgroundTint="@android:color/transparent"
                android:progressTint="@color/browserFabIcon"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Paste: bottom corner. Only on the main screen: BrowserActivity hides it while a page is open. -->
    <LinearLayout
        android:id="@+id/browserHomeButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/browserPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/browserPaste"
            app:backgroundTint="@color/browserFab"
            app:fabSize="normal"
            app:shapeAppearanceOverlay="@style/BrowserFabShape"
            app:srcCompat="@drawable/ic_paste_24dp"
            app:tint="@color/browserFabIcon" />
    </LinearLayout>

    <!-- Detected download: only while a page is open (BrowserActivity shows it), and the person can drag it anywhere.
         Dimmed until the page offers a video or a file; light colors so it stands out. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/browserDetect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:alpha="0.4"
        android:contentDescription="@string/browserDetectNone"
        android:visibility="gone"
        app:backgroundTint="@color/browserFabIcon"
        app:fabSize="normal"
        app:shapeAppearanceOverlay="@style/BrowserFabShape"
        app:srcCompat="@drawable/ic_download_24dp"
        app:tint="@color/browserFab" />
</FrameLayout>
