<?xml version="1.0" encoding="utf-8"?>
<!-- One tile of the browser's quick sites: a rounded square with the site's letter (or a + for the Add tile), and its
     name under it. Filled in by BrowserHome. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/quickSiteIcon"
        android:layout_width="60dp"
        android:layout_height="60dp">

        <TextView
            android:id="@+id/quickSiteLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/quickSiteAdd"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_add_24dp"
            android:visibility="gone"
            app:tint="@color/browserHint" />
    </FrameLayout>

    <TextView
        android:id="@+id/quickSiteName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/browserText"
        android:textSize="12sp" />
</LinearLayout>
