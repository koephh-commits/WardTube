<?xml version="1.0" encoding="utf-8"?>
<!--
    One setting of the three-dots menu: a tinted icon, a title with an optional line under it, and at the end a value, a
    switch or an arrow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Rounded square behind the icon; the code tints both with the accent of the group. -->
    <ImageView
        android:id="@+id/menuRowIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_menu_tile"
        android:importantForAccessibility="no"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/menuRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/menuRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAlignment="viewStart"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The current value of a row that opens a choice (the chosen theme, the sleep time left). -->
    <TextView
        android:id="@+id/menuRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="150dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- The row itself takes the tap; the switch only shows the state. -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/menuRowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/menuRowChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_24dp"
        android:tint="?android:attr/textColorSecondary"
        android:visibility="gone" />
</LinearLayout>
