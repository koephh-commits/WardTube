<?xml version="1.0" encoding="utf-8"?>
<!--
    The player chooser (see PlayerChoiceSheet): opened by a tap on a video or a song of the Library. It is drawn like the
    three-dots menu and the video sheet (the same sheet, rounded cards and tinted tiles): the file (its picture, name and
    kind), the built-in player on top in an outlined card marked "Recommended", the other player apps of the phone under
    it, and a switch that keeps the choice. The rows are added in code.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_menu_handle" />

        <!-- The file: its picture, its name and what it is -->
        <LinearLayout
            android:id="@+id/playerSheetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_thumb_soft">

                <ImageView
                    android:id="@+id/playerSheetGlyph"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_white_24dp"
                    app:tint="@color/brandText" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/playerSheetThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ThumbRounded" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- anyRtl: a name with any Arabic letter reads right to left as a whole, so a mixed name is not scrambled. -->
                <TextView
                    android:id="@+id/playerSheetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAlignment="viewStart"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textDirection="anyRtl"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerSheetMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/playerSheetSection"
            style="@style/PlayerChoiceSection"
            android:text="@string/playerChoiceSection" />

        <!-- The recommended player: its own outlined, softly tinted card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playerSheetRecommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/playerRecommendedBg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brandText"
            app:strokeWidth="1.5dp" />

        <TextView
            android:id="@+id/playerSheetOthersLabel"
            style="@style/PlayerChoiceSection"
            android:layout_marginTop="18dp"
            android:text="@string/playerChoiceOthers" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playerSheetOthersCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/menuCard"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/playerSheetApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Shown instead of the card when the phone has no other player. -->
        <TextView
            android:id="@+id/playerSheetNone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="@string/playerChoiceNone"
            android:textAlignment="viewStart"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- "Always use my choice": its row is added in code -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playerSheetRememberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/menuCard"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
