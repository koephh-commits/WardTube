<?xml version="1.0" encoding="utf-8"?>
<!-- The open page, at the top of the link field's suggestions (like Chrome's card): its name and address, and three
     buttons: edit the address, copy it, share it. Filled in by OmniboxPanel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_browser_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/omniPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/browserText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/omniPageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/browserFabIcon"
            android:textDirection="ltr"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/omniPageEdit"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/omniboxEdit"
        android:src="@drawable/ic_edit_24dp"
        app:tint="@color/browserText" />

    <ImageButton
        android:id="@+id/omniPageCopy"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/omniboxCopy"
        android:src="@drawable/ic_copy_24dp"
        app:tint="@color/browserText" />

    <ImageButton
        android:id="@+id/omniPageShare"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/omniboxShare"
        android:src="@drawable/ic_share_24dp"
        app:tint="@color/browserText" />
</LinearLayout>
