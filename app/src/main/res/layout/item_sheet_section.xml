<?xml version="1.0" encoding="utf-8"?>
<!-- A section title of a bottom sheet: its name and, at the end, how many items it holds (hidden when not needed). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="14dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textAllCaps="true"
        android:textColor="@color/browserFabIcon"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/browserHint"
        android:textSize="12sp" />
</LinearLayout>
