<?xml version="1.0" encoding="utf-8"?>
<!-- The app badge at the top of the three-dots menu: the blue-to-cyan gradient of the launcher icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/menuLogoEnd"
        android:startColor="@color/menuLogoStart"
        android:type="linear" />
    <corners android:radius="15dp" />
</shape>
