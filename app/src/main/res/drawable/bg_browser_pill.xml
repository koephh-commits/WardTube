<?xml version="1.0" encoding="utf-8"?>
<!-- The link field of the browser screen: a filled pill with a thin outline; light green while the field has the focus
     (BrowserActivity marks the pill as activated then). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/browserSheet" />
            <stroke
                android:width="1.5dp"
                android:color="@color/browserFabIcon" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/browserSheet" />
            <stroke
                android:width="1dp"
                android:color="@color/browserSheetDivider" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
