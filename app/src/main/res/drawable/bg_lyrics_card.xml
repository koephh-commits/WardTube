<?xml version="1.0" encoding="utf-8"?>
<!-- The card the words of a song are shown on (LyricsView): the same dark, soft card the Wardio web player uses
     (rgba(40, 40, 40, 0.9), a thin light border, round corners). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#E6282828" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
    <corners android:radius="16dp" />
</shape>
