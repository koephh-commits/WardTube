<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity">

    <!--
        The bottom bar: six slots that never move. Home, browser, library and the three-dots button are always
        usable. The download button is dimmed while there is nothing to download. The first slot is never empty:
        it is the minimize arrow while a video is full screen and the voice search microphone the rest of the time
        (MenuController.setVideoFullScreen swaps its icon, title and action; its id stays action_minimize). Nothing
        is ever hidden, because a hidden item makes ActionMenuView spread the other buttons again and they would
        jump sideways (see MenuController.setUp).
        Everything else (refresh, share and all the settings) is in the sheet that the last button opens, grouped
        by what it is for (see MenuController.showMenuSheet); voice search is also there.
    -->

    <item
        android:id="@+id/action_minimize"
        android:icon="@drawable/ic_mic_white_24dp"
        android:title="@string/voiceSearch"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_home"
        android:icon="@drawable/ic_home_white_24dp"
        android:title="@string/home"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_browser"
        android:icon="@drawable/ic_globe_white_24dp"
        android:title="@string/browser"
        app:showAsAction="always" />

    <!-- [إصلاح] Quick download: dimmed until there is something to download (see MainActivity.updateDownloadButton). -->
    <item
        android:id="@+id/action_download"
        android:icon="@drawable/ic_download_24dp"
        android:title="@string/download"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_library"
        android:icon="@drawable/ic_library_white_24dp"
        android:title="@string/library"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_more"
        android:icon="@drawable/ic_dots_vertical_white_24dp"
        android:title="@string/menuMore"
        app:showAsAction="always" />

</menu>
